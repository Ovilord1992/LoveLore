DATABASE_URL="postgresql://amoria:amoria@localhost:5432/amoria?schema=public"
PORT=3000
UPLOAD_DIR=./uploads
JWT_SECRET=amoria-dev-secret-change-in-production
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Apple Sign-In: bundle ID (iOS) or Service ID (Web) — обязателен для /v1/auth/social с provider=apple
APPLE_CLIENT_ID=
# CORS: список разрешённых origins (через запятую) для браузерных клиентов (admin, editor).
# Запросы без origin (Flutter mobile, curl, Postman) проходят всегда.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
