# ─── Пример конфигурации сервера Amoria ──────────────────────────────────────
# Скопируйте в .env и заполните реальными значениями. .env НЕ коммитится.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# HTTP-порт сервера
PORT=3000

# Директория для загруженных ZIP-паков и обложек
UPLOAD_DIR=./uploads

# Секрет для подписи JWT. ОБЯЗАТЕЛЕН в production и НЕ должен совпадать с dev-дефолтом.
JWT_SECRET=change-me

# Google Sign-In: OAuth Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign-In: bundle ID (iOS) или Service ID (Web) — обязателен для /v1/auth/social с provider=apple
APPLE_CLIENT_ID=

# CORS: список разрешённых origins (через запятую) для браузерных клиентов (admin, editor).
# Запросы без origin (Flutter mobile, curl, Postman) проходят всегда.
# CORS_ORIGINS — каноничное имя; ALLOWED_ORIGINS поддерживается для совместимости.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Redis для общего rate-limit между инстансами (опционально).
# Без него — in-memory стор + warning в prod-логе.
# REDIS_URL=redis://localhost:6379

# Пароль админа для prisma db seed. Без него seed сгенерирует случайный
# и один раз напечатает его в stdout.
# SEED_ADMIN_PASSWORD=

# ─── IAP (In-App Purchase) валидация ─────────────────────────────────────────
# IAP_VALIDATOR=mock — всегда verified=true, только для dev/test (запрещён в production).
# IAP_VALIDATOR=real — реальная проверка через App Store / Google Play.
IAP_VALIDATOR=mock
# Apple App-Specific Shared Secret (App Store Connect → Apps → App Information → App-Specific Shared Secret)
APPLE_SHARED_SECRET=
# Google Play: содержимое JSON-ключа сервисного аккаунта (целиком, в одну строку)
# с правом androidpublisher.purchases.* (роль Service Account User в Play Console).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Имя пакета Android-приложения, например com.amoria.app
GOOGLE_PLAY_PACKAGE_NAME=

# ─── IAP server-to-server нотификации ────────────────────────────────────────
# Apple App Store Server Notifications V2 (POST /v1/iap/notifications/apple).
# Без полного набора переменных нотификации только сохраняются (без действий).
# APPLE_ENV: Sandbox | Production (дефолт Production)
APPLE_ENV=Production
# Bundle ID приложения (для верификации подписи JWS)
APPLE_BUNDLE_ID=
# Директория с DER-корневыми сертификатами Apple (AppleRootCA-G3.cer и т.п.,
# скачиваются с https://www.apple.com/certificateauthority/)
APPLE_ROOT_CA_DIR=
# Числовой Apple ID приложения (обязателен при APPLE_ENV=Production)
APPLE_APP_APPLE_ID=

# Google RTDN (POST /v1/iap/notifications/google): audience OIDC-токена
# Pub/Sub push-подписки. Без него нотификации только сохраняются.
GOOGLE_RTDN_AUDIENCE=
