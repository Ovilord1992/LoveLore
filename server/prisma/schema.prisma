generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  displayName   String    @default("Читатель") @map("display_name")
  role          Role      @default(user)
  vipExpiresAt  DateTime? @map("vip_expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  saves    GameSave[]
  profile  UserProfileData?
  currency CurrencyData?
  ratings   Rating[]
  reviews   Review[]
  favorites Favorite[]
  iapTransactions IapTransaction[]

  @@map("users")
}

model GameSave {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  novelId   String   @map("novel_id")
  data      Json     // полный GameState как JSON
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@map("game_saves")
}

model UserProfileData {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  displayName          String   @default("Читатель") @map("display_name")
  avatarIndex          Int      @default(0) @map("avatar_index")
  totalNovelsStarted   Int      @default(0) @map("total_novels_started")
  totalNovelsCompleted Int      @default(0) @map("total_novels_completed")
  totalChoicesMade     Int      @default(0) @map("total_choices_made")
  totalChaptersRead    Int      @default(0) @map("total_chapters_read")
  unlockedCGs          String[] @default([]) @map("unlocked_cgs")
  achievements         String[] @default([])
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model CurrencyData {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  diamonds         Int       @default(50)
  tickets          Int       @default(5)
  lastTicketRefill DateTime? @map("last_ticket_refill")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("currency")
}

model Novel {
  id               String   @id @default(uuid())
  title            String
  description      String   @default("")
  author           String   @default("")
  coverUrl         String?  @map("cover_url")
  tags             String[] @default([])
  version          Int      @default(1)
  chaptersCount    Int      @default(0) @map("chapters_count")
  releasedChapters Int      @default(0) @map("released_chapters")
  zipFilename      String?  @map("zip_filename")
  fileSize         Int      @default(0) @map("file_size")
  downloads        Int      @default(0)
  isPublished      Boolean  @default(true) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  averageRating Float    @default(0) @map("average_rating")
  ratingCount   Int      @default(0) @map("rating_count")

  chapters  Chapter[]
  ratings   Rating[]
  reviews   Review[]
  favorites Favorite[]

  @@map("novels")
}

model Chapter {
  id         String    @id @default(uuid())
  novelId    String    @map("novel_id")
  number     Int
  title      String    @default("")
  isReleased Boolean   @default(true) @map("is_released")
  releasedAt DateTime? @map("released_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, number])
  @@map("chapters")
}

model GameConfig {
  id        String   @id @default("singleton")
  version   Int      @default(1)
  economy   Json     @default("{}")
  ads       Json     @default("{}")
  iap       Json     @default("{}")
  vip       Json     @default("{}")
  daily     Json     @default("{}")
  achievements Json  @default("[]")
  localization Json  @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("game_config")
}

model Rating {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  novelId   String   @map("novel_id")
  value     Int      // 1-5
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@map("ratings")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  novelId   String   @map("novel_id")
  text      String
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@map("reviews")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  novelId   String   @map("novel_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@map("favorites")
}

model IapTransaction {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  platform        String   // "apple" | "google"
  productId       String   @map("product_id")
  transactionId   String   @map("transaction_id")  // originalTransactionId у Apple, orderId у Google
  receiptHash     String   @map("receipt_hash")    // SHA-256 от полного receipt — чтобы не хранить весь чек
  verified        Boolean  @default(false)
  rewardClaimed   Boolean  @default(false) @map("reward_claimed")
  rawResponseLog  Json?    @map("raw_response_log") // для дебага, опционально
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, transactionId])
  @@index([userId])
  @@map("iap_transactions")
}
